# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wordflow

# JWT
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# GigaChat - Вариант 1 (рекомендуется): Authorization Key из личного кабинета
GIGACHAT_AUTH_KEY=your-authorization-key-from-studio

# GigaChat - Вариант 2: Client ID + Client Secret (НЕ Authorization Key!)
# GIGACHAT_CLIENT_ID=your-client-id
# GIGACHAT_CLIENT_SECRET=your-client-secret

# CORS
CORS_ORIGINS=["http://localhost:5173"]
